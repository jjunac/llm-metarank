---
import "@fontsource-variable/inter";
import "@fontsource/instrument-serif";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import type { LeaderboardDataset } from "../../scripts/types";
import { formatDate } from "../lib/format";

interface Props {
  title?: string;
  description?: string;
  data?: LeaderboardDataset;
}

const {
  title = "LLM MetaRank — The meta ranking for AI models",
  description = "A Metacritic-style meta ranking for large language models, built from multiple benchmark leaderboards.",
  data,
} = Astro.props;

const updated = data ? formatDate(data.generatedAt.slice(0, 10)) : null;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = stored || (prefersDark ? "dark" : "light");

        const applyLabel = () => {
          const button = document.getElementById("theme-toggle");
          if (button) {
            const isDark = root.dataset.theme === "dark";
            button.textContent = isDark ? "Light" : "Dark";
            button.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
          }
        };

        window.addEventListener("DOMContentLoaded", () => {
          applyLabel();
          document.getElementById("theme-toggle")?.addEventListener("click", () => {
            root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
            localStorage.setItem("theme", root.dataset.theme);
            applyLabel();
          });
        });
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <header class="sticky top-0 z-40 border-b border-line bg-paper/80 backdrop-blur">
      <div class="container-page flex h-16 items-center justify-between gap-4">
        <a href="/" class="group flex items-center gap-3 focus-ring" aria-label="LLM MetaRank home">
          <span class="relative flex h-8 w-8 items-center justify-center overflow-hidden rounded-full border border-ink bg-ink text-paper">
            <span class="absolute inset-x-0 top-1/2 h-px bg-paper/40"></span>
            <span class="relative -translate-y-0.5 font-mono text-[10px] font-semibold tracking-tighter">MR</span>
          </span>
          <span class="flex items-baseline gap-1.5">
            <span class="text-sm font-semibold tracking-tight">LLM MetaRank</span>
            <span class="hidden text-[10px] uppercase tracking-[0.14em] text-muted sm:inline">beta</span>
          </span>
        </a>

        <nav class="hidden items-center gap-6 text-xs font-medium text-muted md:flex" aria-label="Main navigation">
          <a href="/#leaderboard" class="transition-colors hover:text-ink">Leaderboard</a>
          <a href="/#frontier" class="transition-colors hover:text-ink">Cost frontier</a>
          <a href="/#sources" class="transition-colors hover:text-ink">Sources</a>
          <a href="/methodology" class="transition-colors hover:text-ink">Methodology</a>
        </nav>

        <div class="flex items-center gap-3">
          {updated && (
            <span class="hidden items-center gap-1.5 text-[11px] text-muted sm:flex md:hidden lg:flex">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              Updated {updated}
            </span>
          )}
          <a href="/methodology" class="text-[11px] text-muted transition-colors hover:text-ink md:hidden">
            Methodology
          </a>
          <a
            href="https://github.com/jjunac/llm-metarank"
            target="_blank"
            rel="noreferrer"
            aria-label="View source on GitHub"
            title="View source on GitHub"
            class="focus-ring inline-flex items-center gap-1.5 rounded-full border border-line px-2.5 py-1.5 text-[11px] font-medium text-muted transition-colors hover:border-ink hover:text-ink"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-3.5 w-3.5" fill="currentColor">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.31.678.921.678 1.856 0 1.34-.012 2.421-.012 2.75 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
              />
            </svg>
            <span class="hidden lg:inline">GitHub</span>
          </a>
          <button
            id="theme-toggle"
            type="button"
            class="focus-ring rounded-full border border-line px-3 py-1.5 text-[11px] font-medium text-muted transition-colors hover:border-ink hover:text-ink"
            aria-label="Toggle theme"
          >
            Dark
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-line bg-surface/50">
      <div class="container-page py-10">
        <div class="grid gap-8 md:grid-cols-[1.2fr_1fr]">
          <div>
            <div class="mb-3 flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-accent"></span>
              <span class="eyebrow">About this project</span>
            </div>
            <p class="max-w-xl text-sm leading-6 text-muted">
              LLM MetaRank compiles publicly displayed scores from independent leaderboards into one
              relative score. It is an editorial aggregation, not an official benchmark, and it is not
              affiliated with any of the source providers.
            </p>
            <p class="mt-3 max-w-xl text-xs leading-5 text-muted/80">
              A meta score answers “how highly do these benchmarks rank this model relative to its
              peers?” It does not measure absolute capability or fitness for a specific product.
              Measured task costs are compared separately in the Pareto frontier.
            </p>
          </div>
          <div>
            <div class="eyebrow mb-3">Data sources</div>
            <ul class="grid grid-cols-1 gap-x-5 gap-y-2 text-xs text-muted sm:grid-cols-2">
              {data?.sources.map((source) => (
                <li>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noreferrer"
                    class="group inline-flex items-center gap-1.5 transition-colors hover:text-ink"
                  >
                    <span class="truncate">{source.shortName}</span>
                    <span class="text-muted/50 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="mt-8 flex flex-col gap-2 border-t border-line pt-5 text-[11px] text-muted/70 sm:flex-row sm:items-center sm:justify-between">
          <span>
            Open source under the{" "}
            <a
              href="https://github.com/jjunac/llm-metarank/blob/main/LICENSE"
              target="_blank"
              rel="noreferrer"
              class="underline-offset-2 transition-colors hover:text-ink hover:underline"
            >MIT License</a>.
          </span>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <a
              href="https://github.com/jjunac/llm-metarank"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-1 transition-colors hover:text-ink"
            >
              View source on GitHub <span aria-hidden="true">↗</span>
            </a>
            <span class="font-mono">methodology v{data?.methodologyVersion ?? "1.0"}</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
